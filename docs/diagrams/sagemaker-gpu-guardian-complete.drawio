        <mxCell id="e19" value="assume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="lambda" target="deployrole">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="create or delete a student stack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="deployrole" target="cfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=1;" edge="1" parent="1" source="cfn" target="execrole">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="ListApps every 5 min &#8212; this is the meter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="lambda" target="studio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="encrypts all three tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=1;" edge="1" parent="1" source="kms" target="ddb-ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" value="encrypts notebook home" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=1;" edge="1" parent="1" source="kms" target="efs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e25" value="1. attach at the cap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=0;" edge="1" parent="1" source="lambda" target="denypol">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" value="2. invoke at the cap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=0;" edge="1" parent="1" source="lambda" target="stopapp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="3. DeleteApp &#8212; stops the meter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=0;" edge="1" parent="1" source="stopapp" target="profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="hosted in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="profile" target="studio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="runs as" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="execrole" target="profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="same console, student view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="student" target="cf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e31" value="presigned URL, or the IdC Studio tile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=0;" edge="1" parent="1" source="student" target="studio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=1;" edge="1" parent="1" source="studio" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e33" value="notify-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=1;" edge="1" parent="1" source="anomaly" target="sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" value="sampled requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#DD344C;dashed=1;" edge="1" parent="1" source="waf" target="cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note-cap" value="&lt;b&gt;How the cap is enforced&lt;/b&gt;&lt;br&gt;Every &lt;i&gt;SweepMinutes&lt;/i&gt; (5 by default) the backend lists running apps, prices them from a built-in rate table and adds the delta to &lt;i&gt;usage-ledger&lt;/i&gt;. At or above the student&#39;s enforced cap it does two things, in order: attaches &lt;i&gt;DenyNewAppsPolicy&lt;/i&gt; so nothing new can start, then invokes the stop-app Lambda to delete what is already running. Layer 1 on its own would leave a running notebook billing.&lt;br&gt;&lt;br&gt;It fails &lt;i&gt;silent&lt;/i&gt;, not closed: disable the rule or break the backend and notebooks keep running. That is what the three CloudWatch alarms are for." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="220" height="310" as="geometry" />
        </mxCell>
        <mxCell id="note-waf" value="&lt;b&gt;The WAF is not the authorization boundary&lt;/b&gt;&lt;br&gt;It only ever sees requests for public static assets. Authorization is the JWT authorizer on the HTTP API, which sits behind API Gateway rather than behind this distribution.&lt;br&gt;&lt;br&gt;A &lt;i&gt;Scope: CLOUDFRONT&lt;/i&gt; web ACL can only exist in us-east-1, so it is gated on the region. Deploy elsewhere and the console comes up unprotected with no warning &#8212; check the &lt;i&gt;FrontendWebAclArn&lt;/i&gt; output." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="730" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note-cost" value="&lt;b&gt;Control plane: $11.23 a month, fixed&lt;/b&gt;&lt;br&gt;$9.02 of that is the WAF and $1.00 a KMS key, and neither scales with headcount. The variable part is about a cent per student. At 100 students the entire control plane is 0.4% of the bill; GPU hours are 97.8%." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-immutable" value="&lt;b&gt;Both create-only&lt;/b&gt;&lt;br&gt;&lt;i&gt;AuthMode&lt;/i&gt; and &lt;i&gt;KmsKeyId&lt;/i&gt; on the domain cannot be changed. Replacing the domain destroys every student&#39;s home directory, and a domain created before &lt;i&gt;KmsKeyId&lt;/i&gt; was added cannot be updated into it at all &#8212; the replacement collides with the live domain on DomainName." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="760" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-tier" value="&lt;b&gt;The tier control is an AllowedValues list&lt;/b&gt;&lt;br&gt;&lt;i&gt;ml.t3.medium, ml.g4dn.xlarge, ml.g5.xlarge, ml.g6.xlarge&lt;/i&gt; on the student template. There is no other check on what a student may ask for.&lt;br&gt;&lt;br&gt;Per-student resource names are load-bearing: the console&#39;s IAM is scoped to &lt;i&gt;gpu-guardian-${StudentId}-exec-role&lt;/i&gt;, &lt;i&gt;-deny-new-apps&lt;/i&gt; and &lt;i&gt;-stop-app&lt;/i&gt; by ArnLike across a stack boundary. Renaming one does not fail a deploy, it just stops enforcement working." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1770" y="1060" width="390" height="180" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Solid&lt;/b&gt; = request or data flow &#183; &lt;b&gt;dashed&lt;/b&gt; = trust, encryption or telemetry &#183; &lt;b&gt;red&lt;/b&gt; = the enforcement path &#183; &lt;b&gt;1 &#8594; 2 &#8594; 3&lt;/b&gt; = the order enforcement happens in" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fontColor=#5f6b7a;" vertex="1" parent="1">
          <mxGeometry x="340" y="1170" width="1200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="The two CloudFormation templates are the source of truth; docs/ARCHITECTURE.md has the resource-by-resource inventory. Revised 27 August 2026." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#5f6b7a;" vertex="1" parent="1">
          <mxGeometry x="340" y="1196" width="1200" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
