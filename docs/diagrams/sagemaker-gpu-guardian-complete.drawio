        <mxCell id="e18" value="access logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=1.5;strokeColor=#5A6C86;dashed=1;" edge="1" parent="1" source="cf" target="s3logs">
