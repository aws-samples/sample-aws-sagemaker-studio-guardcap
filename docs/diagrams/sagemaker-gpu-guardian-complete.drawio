        <mxCell id="title" value="SageMaker GPU Guardian &#8212; platform architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
