<mxfile host="app.diagrams.net" agent="gpu-guardian" version="29.6.1">
  <diagram name="How the limit works" id="gpu-guardian-simple">
    <mxGraphModel dx="1400" dy="850" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="How the $80 spending limit works" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="34" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Each student gets their own GPU notebook. Their spend is measured every five minutes, and when it reaches the limit the notebook is shut down automatically. Nobody has to be watching." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#5f6b7a;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="student" value="Student" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.users;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="200" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="notebook" value="GPU notebook&lt;div&gt;&lt;i&gt;started on demand, billed by the second&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sagemaker;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="meter" value="Usage meter&lt;div&gt;&lt;i&gt;runs every 5 minutes&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="Running total&lt;div&gt;&lt;i&gt;what this student has spent&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Reached&lt;br&gt;&lt;b&gt;$80&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffce9;strokeColor=#8d6605;fontColor=#8d6605;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="195" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="act" value="&lt;b&gt;Yes &#8212; two things happen&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. New notebooks are blocked&lt;br&gt;2. The running one is shut down" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3f4;strokeColor=#DD344C;fontColor=#7d2027;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="130" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="noact" value="&lt;b&gt;No &#8212; keep working&lt;/b&gt;&lt;br&gt;The student can see how much of the limit is left" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fcf3;strokeColor=#037f0c;fontColor=#0b5c14;fontSize=12;align=center;verticalAlign=middle;fontFamily=Helvetica;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="280" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. starts a notebook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#0972d3;dashed=0;" edge="1" parent="1" source="student" target="notebook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. checks what is running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#5f6b7a;dashed=1;" edge="1" parent="1" source="meter" target="notebook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. prices it and adds it up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#0972d3;dashed=0;" edge="1" parent="1" source="meter" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. compare" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#0972d3;dashed=0;" edge="1" parent="1" source="ledger" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="at the limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#DD344C;dashed=0;" edge="1" parent="1" source="check" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="under it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#037f0c;dashed=0;" edge="1" parent="1" source="check" target="noact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="5. shut down &#8212; the meter stops here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#DD344C;dashed=0;" edge="1" parent="1" source="act" target="notebook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="Lab admin" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="firewall" value="Web firewall&lt;div&gt;&lt;i&gt;in front of the console&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="console" value="Admin console&lt;div&gt;&lt;i&gt;add students, set limits, see spend&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="470" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="Email alert&lt;div&gt;&lt;i&gt;sent if the machinery itself breaks&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.email_notification;fontFamily=Helvetica;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="470" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="signs in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#0972d3;dashed=0;" edge="1" parent="1" source="admin" target="firewall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#0972d3;dashed=0;" edge="1" parent="1" source="firewall" target="console">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="reads the same figure the limit uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#5f6b7a;dashed=1;" edge="1" parent="1" source="console" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#5f6b7a;dashed=1;" edge="1" parent="1" source="meter" target="alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="sees their own usage page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#5f6b7a;dashed=1;" edge="1" parent="1" source="student" target="console">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="caveat" value="&lt;b&gt;Two things to know about the limit&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;It is not instantaneous.&lt;/b&gt; Usage is checked every five minutes, so a student can land a few cents over &#8212; about 9&#162; on the machine we recommend. Across 100 students that is under $10.&lt;br&gt;&lt;br&gt;&lt;b&gt;It covers machine time, not saved files.&lt;/b&gt; A student&#39;s 56&#162; of storage sits outside the $80, so the true worst case is $80.56 plus a few cents. Students are shown this wording on their own usage page." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f8fd;strokeColor=#0972d3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1110" y="400" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="facts" value="&lt;b&gt;What $80 buys&lt;/b&gt;&lt;br&gt;About 71 hours on &lt;i&gt;ml.g6.xlarge&lt;/i&gt;, the machine the lab defaults to &#8212; roughly 2.7 hours a week across a trimester.&lt;br&gt;&lt;br&gt;&lt;b&gt;What the lab costs to run&lt;/b&gt;&lt;br&gt;$11.23 a month for the whole class, whatever its size. For 100 students the expected bill is about $2,997 a month and the hard ceiling is $8,070." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f8fd;strokeColor=#0972d3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="480" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fails-open" value="&lt;b&gt;Where the honesty is&lt;/b&gt;&lt;br&gt;The limit is enforced by this platform, not by AWS billing. If the meter stops running, notebooks are &lt;i&gt;not&lt;/i&gt; shut down &#8212; they keep going. That is what the email alert is for, so it has to go somewhere a person actually reads." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f8fd;strokeColor=#0972d3;align=left;verticalAlign=top;fontSize=11;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Figures are AWS list prices for N. Virginia, retrieved 24 August 2026, excluding tax and any discount. Full breakdown in docs/COSTING.md. Revised 27 August 2026." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontFamily=Helvetica;fontColor=#5f6b7a;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="1000" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
